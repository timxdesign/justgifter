{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justgifter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // The Worker runs first for public routes so it can inject SEO metadata
    // and apply no-store caching to private routes (PRD §14 public rendering).
    "run_worker_first": ["/*", "!/assets/*", "!/media/*", "!/favicon.svg"],
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_SITE_URL": "https://justgifter.com",
    "SUPABASE_URL": "https://bsvldgnzxjdglkvyycyu.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJzdmxkZ256eGpkZ2xrdnl5Y3l1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA4NTc5NjIsImV4cCI6MjEwNjQzMzk2Mn0.AdT_OTEe89c3Sb5JK1iSwrlvMhpkNW9Nudl5ZZMtoGg"
  },
  "env": {
    "staging": {
      "name": "justgifter-staging",
      "vars": { "PUBLIC_SITE_URL": "https://staging.justgifter.com", "SUPABASE_URL": "https://bsvldgnzxjdglkvyycyu.supabase.co", "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJzdmxkZ256eGpkZ2xrdnl5Y3l1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA4NTc5NjIsImV4cCI6MjEwNjQzMzk2Mn0.AdT_OTEe89c3Sb5JK1iSwrlvMhpkNW9Nudl5ZZMtoGg" }
    }
  }
}
