# Edge Function secrets — set with:  supabase secrets set --env-file supabase/.env
# Never commit real values. Use separate Supabase projects and keys per environment (TECH 01).
SITE_URL=https://justgifter.com
ALLOWED_ORIGINS=https://justgifter.com,https://staging.justgifter.com
PAYSTACK_SECRET_KEY=sk_test_xxx
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=465
SMTP_USER=emailapikey
SMTP_PASS=
MAIL_FROM=JustGifter <hello@justgifter.com>
# Only "true" in production; staging and previews log emails instead of sending them.
SEND_REAL_EMAIL=false
CRON_SECRET=generate-a-long-random-string
TURNSTILE_SECRET_KEY=
# Auth → Hooks → Send Email: the generated secret (starts with v1,whsec_)
SEND_EMAIL_HOOK_SECRET=
# Must match Auth → Email OTP expiration (seconds); shown in the email as minutes
AUTH_CODE_SECONDS=600
