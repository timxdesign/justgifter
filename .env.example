# Public configuration only — every VITE_ value ships in browser JavaScript (TECH 02).
# Leave the Supabase values empty to run the in-browser demo backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://127.0.0.1:5173
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
# Set to "true" to force the demo backend even when Supabase is configured.
VITE_DEMO_MODE=
